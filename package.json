{
  "name": "@weibaohui/hermes-loop",
  "version": "0.1.4",
  "description": "dsh 插件 · 自动复盘：对话收尾后自动复盘，把有价值的经验蒸馏成可复用的技能（skill）存入技能库，模型可直接调用；支持信号加速触发、手动立即复盘、审批模式与技能库治理（归档/恢复，永不直接删除）。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "skills",
    "hermes",
    "learning-loop",
    "dsh-plugin"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "docs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/bundle.js",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/hermes-loop.git"
  },
  "homepage": "https://github.com/weibaohui/hermes-loop#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/hermes-loop/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
